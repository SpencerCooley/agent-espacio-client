# Build context hygiene — without this, ~1.8GB (node_modules + .next)
# is uploaded to the Docker daemon on every build.

# Dependencies & build output (built fresh inside the image)
node_modules
.next
out
build

# VCS
.git
.gitignore

# Local env (secrets never belong in an image; NEXT_PUBLIC_* come via build args)
.env
.env.*
!.env.example

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore

# Docs & misc
*.md
.vscode
.idea
coverage
.turbo
.vercel
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
